---
/**
 * Layout base globale dell'applicazione Brilla Cafe.
 * Include Header, Footer, CartDrawer globale (Nanostores) e metadati SEO/JSON-LD.
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CartDrawer from '../components/cart/CartDrawer';
import CookieBanner from '../components/layout/CookieBanner';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article' | 'product';
  schema?: Record<string, any>;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title = "Brilla Cafe — Cartoleria, Edicola & Bar a Castelnuovo Bocca d'Adda",
  description = "Il tuo negozio e bar di fiducia a Castelnuovo Bocca d'Adda. Articoli scuola, ufficio, quotidiani, riviste, idee regalo e servizio Scegli e Ritira.",
  image = '/logo.jpeg',
  canonicalURL,
  type = 'website',
  schema,
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://brillacafe.it';
const resolvedCanonical = canonicalURL || new URL(Astro.url.pathname, Astro.site || siteUrl).href;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? image : `/${image}`}`;

// Schema JSON-LD LocalBusiness & CafeOrCoffeeShop per Local SEO
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'CafeOrCoffeeShop'],
  '@id': `${siteUrl}/#localbusiness`,
  name: "Brilla Cafè",
  legalName: 'Brilla SAS di Bricchi Sara e c.',
  alternateName: "Brilla Cafe Castelnuovo Bocca d'Adda",
  image: `${siteUrl}/logo.jpeg`,
  telephone: '+393500206743',
  url: siteUrl,
  priceRange: '€',
  paymentAccepted: 'Cash, Credit Card, PayPal',
  currenciesAccepted: 'EUR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Umberto I, 35',
    addressLocality: "Castelnuovo Bocca d'Adda",
    postalCode: '26843',
    addressRegion: 'LO',
    addressCountry: 'IT',
  },
  vatID: 'IT11824030966',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.1167,
    longitude: 9.8667,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '06:30',
      closes: '19:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday'],
      opens: '07:00',
      closes: '13:00',
    },
  ],
  areaServed: [
    { '@type': 'AdministrativeArea', name: "Castelnuovo Bocca d'Adda" },
    { '@type': 'AdministrativeArea', name: "Monticelli d'Ongina" },
    { '@type': 'AdministrativeArea', name: "Caorso" },
    { '@type': 'AdministrativeArea', name: "Castelvetro Piacentino" },
    { '@type': 'AdministrativeArea', name: "Cremona" },
    { '@type': 'AdministrativeArea', name: "Codogno" },
    { '@type': 'AdministrativeArea', name: "Bassa Lodigiana" },
  ],
  description: "Bar, edicola, cartoleria e articoli regalo a Castelnuovo Bocca d'Adda. Servizio Scegli e Ritira rapido al bancone a zero spese di spedizione.",
};

// Schema BreadcrumbList se fornito
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url.startsWith('/') ? crumb.url : `/${crumb.url}`}`,
  })),
} : null;
---

<!DOCTYPE html>
<html lang="it" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  {/* Canonical Tag */}
  <link rel="canonical" href={resolvedCanonical} />

  {/* SEO Core */}
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="keywords" content="Cartoleria Castelnuovo Bocca d'Adda, Edicola Lodi, Riviste online, Bar Brilla Cafe, Quaderni scuola, Idee regalo artigianali, Scegli e Ritira Castelnuovo" />

  {/* Open Graph / Facebook */}
  <meta property="og:type" content={type} />
  <meta property="og:url" content={resolvedCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:locale" content="it_IT" />

  {/* Twitter */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />

  {/* Favicon & Web App Icons */}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Brilla Cafe" />
  <meta name="theme-color" content="#1ea7b0" />
  <link rel="manifest" href="/site.webmanifest" />

  {/* Fonts */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  {/* JSON-LD LocalBusiness */}
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  
  {/* JSON-LD BreadcrumbList */}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  {/* Extra Schema se fornito */}
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body class="min-h-screen bg-brand-cream text-brand-dark flex flex-col antialiased">
  
  {/* Header di navigazione */}
  <Header />

  {/* Main content slot */}
  <div class="flex-1">
    <slot />
  </div>

  {/* Footer con info locali */}
  <Footer />

  {/* Drawer laterale carrello globale sincronizzato con Nanostores */}
  <CartDrawer client:load />

  {/* Banner informativo cookie tecnici */}
  <CookieBanner client:load />

</body>
</html>
