---
/**
 * Home Page Vetrina di Brilla Cafe.
 * Include Hero, 3 Sezioni Categorie, Vetrina Novità in Evidenza e Info Ritiro.
 */
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CategoryShowcase from '../components/home/CategoryShowcase.astro';
import FeaturedProducts from '../components/home/FeaturedProducts';
---

<Layout
  title="Brilla Cafe — Cartoleria, Edicola & Bar a Castelnuovo Bocca d'Adda"
  description="Il tuo shop di fiducia a Castelnuovo Bocca d'Adda per scuola, ufficio, riviste del mese e idee regalo. Scegli online e ritira subito in negozio senza spese!"
>
  <main>
    {/* 1. Hero Section con presentazione */}
    <HeroSection />

    {/* 2. I 3 Reparti del Negozio */}
    <CategoryShowcase />

    {/* 3. Prodotti in Evidenza (React Island) */}
    <FeaturedProducts client:visible />

    {/* 4. Banner Scegli e Ritira & Assistenza Locale */}
    <section class="py-16 bg-white border-t border-brand-dark/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl bg-brand-dark text-white p-8 sm:p-12 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
          
          <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-amber/20 rounded-full blur-3xl pointer-events-none"></div>

          <div class="space-y-3 max-w-xl text-center md:text-left">
            <span class="px-3 py-1 bg-brand-amber text-white text-xs font-bold uppercase tracking-wider rounded-lg inline-block">
              Come Funziona Scegli &amp; Ritira
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
              Scegli online e ritira quando vuoi in negozio.
            </h3>
            <p class="text-xs sm:text-sm text-white/70 leading-relaxed">
              Aggiungi i tuoi articoli al carrello, seleziona la fascia oraria di ritiro che preferisci e paga direttamente al momento del ritiro in contanti o POS senza costi di spedizione.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <a
              href="/catalogo"
              class="w-full sm:w-auto px-6 py-3.5 bg-brand-amber hover:bg-brand-amber/90 text-white text-xs font-bold rounded-xl shadow-md transition-all text-center"
            >
              Inizia la Spesa
            </a>
            <a
              href="https://wa.me/393500206743?text=Ciao%20Brilla%20Cafe%E2%80%99,%20vorrei%20sapere%20se%20avete%20un%20articolo"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-xl border border-white/20 transition-all text-center"
            >
              Richiedi su WhatsApp
            </a>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>
